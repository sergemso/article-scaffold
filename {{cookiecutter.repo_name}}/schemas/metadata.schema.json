{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sergemso/article-scaffold/schemas/metadata.schema.json",
  "title": "Article metadata",
  "description": "Metadata schema 2 (authors/affiliations) with v1 legacy compatibility.",
  "type": "object",
  "required": ["title"],
  "properties": {
    "metadata_schema": {
      "type": ["integer", "string"],
      "enum": [1, 2, "1", "2"],
      "default": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "abstract": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/author"
      }
    },
    "affiliations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/affiliation"
      }
    },
    "author": {
      "description": "Legacy v1 single-author mapping.",
      "type": ["object", "string"],
      "properties": {
        "name": {"type": "string"},
        "orcid": {"type": "string"},
        "affiliation": {"type": "string"}
      }
    }
  },
  "definitions": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "given": {"type": "string"},
        "family": {"type": "string"},
        "orcid": {
          "type": "string",
          "pattern": "^$|^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$|^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
        },
        "email": {"type": "string"},
        "affiliations": {
          "type": "array",
          "items": {"type": ["string", "integer"]}
        },
        "affiliation": {
          "description": "Legacy convenience field; migrated to affiliations.",
          "type": "string"
        },
        "corresponding": {"type": "boolean"},
        "ror": {
          "type": "string",
          "pattern": "^$|^https://ror\\.org/[0-9a-z]{9}$"
        }
      },
      "anyOf": [
        {"required": ["name"]},
        {"required": ["given"]},
        {"required": ["family"]}
      ]
    },
    "affiliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "id": {"type": ["string", "integer"]},
        "name": {"type": "string", "minLength": 1},
        "ror": {
          "type": "string",
          "pattern": "^$|^https://ror\\.org/[0-9a-z]{9}$"
        }
      }
    }
  }
}
