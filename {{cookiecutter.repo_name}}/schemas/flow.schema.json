{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sergemso/article-scaffold/schemas/flow.schema.json",
  "title": "Flow state",
  "description": "Structure of flow.yaml: only what the repo cannot derive (round, attestations, waivers, budget used) plus the bookkeeping of issued orders. There is no stage pointer. Rules beyond the structure (no agent names in by) are enforced by scripts/article/flow.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "round",
    "weights",
    "budget",
    "retry_cap",
    "attestations",
    "waivers",
    "orders",
    "reviews"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "small",
        "large"
      ],
      "properties": {
        "script": {
          "type": "integer",
          "minimum": 0
        },
        "small": {
          "type": "integer",
          "minimum": 0
        },
        "large": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "used"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "used": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "retry_cap": {
      "type": "integer",
      "minimum": 0
    },
    "attestations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/attestation"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/waiver"
      }
    },
    "orders": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "closed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round",
          "at"
        ],
        "properties": {
          "round": {
            "type": "integer",
            "minimum": 0
          },
          "at": {
            "$ref": "#/definitions/date"
          }
        }
      }
    },
    "brief_bytes": {
      "type": "integer",
      "minimum": 200,
      "description": "Optional byte cap of a compiled brief (`flow next --brief`); the default is 6000. Over the cap the slices are replaced by their addresses."
    },
    "max_calls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "small": {
          "type": "integer",
          "minimum": 1
        },
        "large": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Optional advisory tool-call cap per tier, shown in the order; the host counts, nothing enforces it. Defaults: small 40, large 60."
    },
    "max_context": {
      "type": "integer",
      "minimum": 1000,
      "description": "Optional advisory context threshold in tokens, shown in the order and brief: hand back state when the context reaches it. Fit it with scripts/context-threshold.py from finished runs; when unset, max_calls is the only limit."
    },
    "max_context_ceiling": {
      "type": "integer",
      "minimum": 1000,
      "description": "Optional worst-case context limit in tokens. The threshold shown is the smaller of max_context and this. Unset by default."
    },
    "required_stages": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["dialectic"] },
      "description": "Optional. Advisory stages the author promotes to required. The dialectic stage (only for a map that declares a contradiction or move) is advisory by default: while open it shows as advisory and blocks nothing; listed here it fails `flow status` like any gate. It passes when `theses gaps` has no dialectic gap and a person has run `flow attest dialectic`."
    },
    "group_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional. Most orders in one group of orders that write the same file (`flow next`); the default is 3. Orders beyond it are offered in a later call. 1 turns grouping off."
    }
  },
  "definitions": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n]+$"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "by",
        "at",
        "why"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/line"
        },
        "by": {
          "$ref": "#/definitions/line"
        },
        "at": {
          "$ref": "#/definitions/date"
        },
        "why": {
          "$ref": "#/definitions/line"
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "by",
        "at",
        "why",
        "expires"
      ],
      "properties": {
        "stage": {
          "enum": [
            "frame",
            "dialectic",
            "map",
            "discover",
            "draft",
            "verify-sources",
            "adversarial",
            "revise",
            "release-gate",
            "publish"
          ]
        },
        "by": {
          "$ref": "#/definitions/line"
        },
        "at": {
          "$ref": "#/definitions/date"
        },
        "why": {
          "$ref": "#/definitions/line"
        },
        "expires": {
          "$ref": "#/definitions/date"
        }
      }
    }
  }
}
