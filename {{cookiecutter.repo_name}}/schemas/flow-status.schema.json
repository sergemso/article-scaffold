{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sergemso/article-scaffold/schemas/flow-status.schema.json",
  "title": "Flow status",
  "description": "Stable output of `python3 -m scripts.article flow status`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "command", "round", "current_stage", "budget", "stages", "quality"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "ok": { "type": "boolean" },
    "command": { "type": "string", "const": "flow status" },
    "round": { "type": "integer", "minimum": 0 },
    "current_stage": { "type": ["string", "null"] },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "used"],
      "properties": {
        "limit": { "type": "integer", "minimum": 0 },
        "used": { "type": "integer", "minimum": 0 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "description": "The outcome vector, derived from the repo on every call and never stored (decision 0085).",
      "required": ["theses_accepted", "theses_opened", "contradictions_moved", "claims_verified", "objections_defended", "gaps"],
      "properties": {
        "theses_accepted": { "type": "integer", "minimum": 0 },
        "theses_opened": { "type": "integer", "minimum": 0 },
        "contradictions_moved": { "type": "integer", "minimum": 0 },
        "claims_verified": { "type": "integer", "minimum": 0 },
        "objections_defended": { "type": "integer", "minimum": 0 },
        "gaps": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "status", "reason", "command"],
        "properties": {
          "stage": { "type": "string" },
          "status": { "enum": ["pass", "fail", "waived", "human", "advisory"] },
          "reason": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "relied_on": {
            "type": "object",
            "description": "Tier 2 ledger entries the gate rests on; they cannot be re-run cold.",
            "additionalProperties": false,
            "required": ["count", "entries"],
            "properties": {
              "count": { "type": "integer", "minimum": 0 },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["key", "author"],
                  "properties": {
                    "key": { "type": "string" },
                    "author": { "type": "string" },
                    "recorded": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
