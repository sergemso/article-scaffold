{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sergemso/article-scaffold/schemas/ledger-result.schema.json",
  "title": "Ledger command output",
  "description": "Stable JSON printed by `python3 -m scripts.article ledger <action>`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "command"],
  "properties": {
    "ok": {"type": "boolean"},
    "command": {
      "type": "string",
      "enum": [
        "ledger get", "ledger explain", "ledger verify", "ledger evict", "ledger gc",
        "ledger stats"
      ]
    },
    "error": {"type": "string"},
    "key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hit": {"type": "boolean"},
    "bypassed": {"type": "boolean"},
    "entry": {"type": "object"},
    "provenance": {"type": "array", "items": {"type": "object"}},
    "nearest": {"type": ["string", "null"]},
    "changed": {"type": "array", "items": {"type": "string"}},
    "added": {"type": "array", "items": {"type": "string"}},
    "removed": {"type": "array", "items": {"type": "string"}},
    "other": {"type": "array", "items": {"type": "string"}},
    "problems": {"type": "array", "items": {"type": "string"}},
    "evicted": {"type": "boolean"},
    "applied": {"type": "boolean"},
    "orphans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "key", "reason"],
        "properties": {
          "kind": {"type": "string"},
          "key": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
