{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sergemso/article-scaffold/schemas/theses.schema.json",
  "title": "Theses map",
  "description": "Structure of theses.yaml: a YAML graph of the article's claims, objections and defenses. Graph rules (dangling edges, missing anchors, agent names in accepted-by) are enforced by scripts/article/theses.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "nodes", "edges"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "nodes": { "type": "array", "items": { "$ref": "#/definitions/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } },
    "terms": { "type": "array", "items": { "$ref": "#/definitions/term" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "status"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": {
          "enum": ["thesis", "hypothesis", "objection", "defense", "source-claim", "argument"]
        },
        "text": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" },
        "status": { "enum": ["proposed", "accepted", "retired"] },
        "anchor": { "type": ["string", "null"] },
        "bib_keys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "accepted-by": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "conclusion": { "$ref": "#/definitions/id" },
        "inference": { "enum": ["deduction", "modus-ponens", "modus-tollens", "disjunctive-syllogism", "induction", "abduction", "analogy", "authority"] },
        "premises": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/premise" } },
        "steps": { "type": "array", "items": { "$ref": "#/definitions/step" } },
        "premise-ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argument", "n"],
          "properties": {
            "argument": { "$ref": "#/definitions/id" },
            "n": { "type": "integer", "minimum": 1 }
          }
        },
        "author": { "enum": ["agent", "human"] },
        "target": { "$ref": "#/definitions/id" },
        "form": { "enum": ["strongest", "standard"] },
        "strongest-form": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "restated"],
          "properties": {
            "source": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" },
            "restated": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" }
          }
        },
        "tradition": { "enum": ["internal", "rival", "adjacent", "none"] },
        "kind": {
          "enum": ["counterexample", "undercut", "rebuttal", "scope", "hidden-premise", "evidence"]
        },
        "counterexample": {
          "type": "object",
          "additionalProperties": false,
          "required": ["case", "why-it-bites"],
          "properties": {
            "case": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" },
            "why-it-bites": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" }
          }
        },
        "severity": { "enum": ["fatal", "serious", "minor"] },
        "answers": { "$ref": "#/definitions/id" },
        "move": {
          "enum": [
            "concede-scope",
            "distinguish",
            "deny-premise",
            "accept-cost",
            "cite-evidence",
            "reformulate"
          ]
        },
        "cost": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" },
        "needs-rival-objection": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "accepted" } } },
          "then": { "required": ["accepted-by"] }
        },
        {
          "if": { "properties": { "type": { "const": "source-claim" } } },
          "then": { "required": ["quote", "locator"] }
        },
        {
          "if": { "properties": { "type": { "const": "argument" } } },
          "then": { "required": ["conclusion", "inference", "premises"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["conclusion"] },
                { "required": ["inference"] },
                { "required": ["premises"] },
                { "required": ["steps"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "objection" } } },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["target"] },
                { "required": ["form"] },
                { "required": ["strongest-form"] },
                { "required": ["tradition"] },
                { "required": ["kind"] },
                { "required": ["counterexample"] },
                { "required": ["severity"] },
                { "required": ["premise-ref"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "defense" } } },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["answers"] },
                { "required": ["move"] },
                { "required": ["cost"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "thesis" } } },
          "else": { "not": { "required": ["needs-rival-objection"] } }
        },
        {
          "if": { "properties": { "form": { "const": "strongest" } }, "required": ["form"] },
          "then": { "required": ["strongest-form"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "counterexample" } },
            "required": ["kind"]
          },
          "then": { "required": ["counterexample"] }
        },
        {
          "if": {
            "properties": { "move": { "enum": ["accept-cost", "concede-scope"] } },
            "required": ["move"]
          },
          "then": { "required": ["cost"] }
        }
      ]
    },
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "text"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" },
        "kind": { "enum": ["explicit", "implicit"] },
        "role": { "enum": ["required", "supports-conclusion"] },
        "ref": { "$ref": "#/definitions/id" },
        "status": { "enum": ["proposed", "accepted", "retired"] }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "rule"],
      "properties": {
        "from": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "to": { "type": "string", "minLength": 1 },
        "rule": { "enum": ["deduction", "modus-ponens", "modus-tollens", "disjunctive-syllogism", "induction", "abduction", "analogy", "authority"] }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "$ref": "#/definitions/id" },
        "to": { "$ref": "#/definitions/id" },
        "type": { "enum": ["supports", "attacks", "rebuts"] }
      }
    },
    "line": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" },
    "term": {
      "description": "A defined term (decision 0076). kind defined needs anchor, external needs source, acronym needs expansion. match phrase-only (the default) searches only forms of two or more words and acronyms; match word, or a scope of section files, also searches single-word forms.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "status"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "$ref": "#/definitions/line" },
        "forms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "kind": { "enum": ["defined", "external", "acronym"] },
        "anchor": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "expansion": { "$ref": "#/definitions/line" },
        "definition": { "$ref": "#/definitions/line" },
        "senses": { "type": "array", "items": { "$ref": "#/definitions/sense" } },
        "children": { "type": "array", "items": { "$ref": "#/definitions/term-child" } },
        "status": { "enum": ["proposed", "accepted", "retired"] },
        "author": { "enum": ["agent", "human"] },
        "accepted-by": { "type": "string", "minLength": 1 },
        "match": { "enum": ["phrase-only", "word"] },
        "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor"],
      "properties": {
        "anchor": { "type": "string", "minLength": 1 },
        "definition": { "$ref": "#/definitions/line" }
      }
    },
    "term-child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "$ref": "#/definitions/line" },
        "forms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "definition": { "$ref": "#/definitions/line" }
      }
    }
  }
}
