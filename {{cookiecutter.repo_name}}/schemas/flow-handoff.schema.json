{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sergemso/article-scaffold/schemas/flow-handoff.schema.json",
  "title": "Flow handoff",
  "description": "What an agent hands back when it reaches its call cap (`flow handoff <order> --file`), and the output of that command (`definitions.result`). It names the order, the anchors done and remaining, the files touched, the ledger keys written and the verify outcome. It carries no model or host name and no manuscript text. The CLI validates with scripts/article/handoff.py; this schema states the same rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "order", "done", "remaining", "files", "ledger_keys", "verify"],
  "properties": {
    "version": {"const": "1.0"},
    "order": {"type": "string", "pattern": "^o-[0-9a-f]{12}$"},
    "done": {"$ref": "#/definitions/anchors"},
    "remaining": {"$ref": "#/definitions/anchors"},
    "files": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$"},
      "description": "Relative paths of the files the agent changed."
    },
    "ledger_keys": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "description": "Keys of the ledger entries the agent wrote."
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "outcome"],
      "properties": {
        "check": {"type": ["string", "null"], "pattern": "^[a-z][a-z-]*$"},
        "outcome": {"enum": ["pass", "fail", "not-run"]}
      }
    }
  },
  "definitions": {
    "anchors": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "file"],
        "properties": {
          "name": {"type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#@+=-]*$"},
          "file": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$"}
        }
      },
      "description": "Anchors as `flow next` printed them, identified by file and name. An anchor is not in both done and remaining."
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "command", "id", "handoff", "remaining"],
      "properties": {
        "ok": {"const": true},
        "command": {"const": "flow handoff"},
        "id": {"type": "string", "pattern": "^o-[0-9a-f]{12}$"},
        "handoff": {"$ref": "#"},
        "remaining": {"type": "integer", "minimum": 0}
      }
    }
  }
}
