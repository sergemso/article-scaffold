{
  "title": {{ cookiecutter.title | tojson }},
  "description": {{ cookiecutter.abstract | tojson }},
  "creators": [
    {
      "name": {{ cookiecutter.author_name | tojson }}{% if cookiecutter.author_orcid %},
      "orcid": {{ cookiecutter.author_orcid | tojson }}{% endif %}{% if cookiecutter.author_affiliation %},
      "affiliation": {{ cookiecutter.author_affiliation | tojson }}{% endif %}
    }
  ],
  "keywords": [
{%- for kw in cookiecutter.keywords.split(",") %}
    {{ kw.strip() | tojson }}{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "license": {{ cookiecutter.license | lower | tojson }},
  "upload_type": "publication",
  "publication_type": "{% if 'article' in cookiecutter.manuscript_type | lower %}article{% else %}preprint{% endif %}",
  "access_right": "open",
  "version": {{ cookiecutter.version | tojson }},
  "language": "en",
  "communities": []{% if cookiecutter.doi %},
  "doi": {{ cookiecutter.doi | tojson }}{% endif %}
}
