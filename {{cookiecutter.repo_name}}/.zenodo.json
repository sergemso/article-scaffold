{
  "title": {{ cookiecutter.title | tojson }},
  "description": {{ cookiecutter.abstract | tojson }},
  "creators": [
    {
      "name": {{ cookiecutter.author_name | tojson }},
      "orcid": {{ cookiecutter.author_orcid | tojson }},
      "affiliation": {{ cookiecutter.author_affiliation | tojson }}
    }
  ],
  "keywords": [
{%- for kw in cookiecutter.keywords.split(",") %}
    {{ kw.strip() | tojson }}{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "license": {{ cookiecutter.license | tojson }},
  "upload_type": "publication",
  "publication_type": "preprint",
  "access_right": "open",
  "version": {{ cookiecutter.version | tojson }},
  "language": "en",
  "communities": [
    {
      "identifier": "technology"
    },
    {
      "identifier": "political-science"
    }
  ],
  "related_identifiers": [],
  "references": []
}
