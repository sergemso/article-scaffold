# LaTeX build artifacts (top-level paper/ only — figures/ and supplementary/ are tracked)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.lof
paper/*.lot
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.pdf
paper/build/

# Derived manuscript outputs (regenerated by CI)
manuscript.docx
manuscript.pdf

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Build output dirs
build/
dist/

# Python caches (for generate-metadata.py)
__pycache__/
*.pyc

# Virtual environments
.venv/
venv/

# Generated figures and supplementary builds
paper/figures/generated/
paper/supplementary/build/
paper/supplementary/*.pdf

# Biblatex/biber intermediates
paper/*.bcf
paper/*.run.xml
